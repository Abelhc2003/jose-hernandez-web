# Copia este fichero a .env.local y rellena con los valores reales.
# Nunca subas .env.local al repositorio (está en .gitignore).

# URL pública del sitio — usada para metadatos (OpenGraph, canonical, sitemap)
NEXT_PUBLIC_SITE_URL=https://josehernandezmondejar.com

# Resend — https://resend.com (plan gratuito: hasta 3k emails/mes)
# Crear cuenta, verificar dominio y generar API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente del email del formulario de contacto (debe ser un dominio verificado en Resend)
# Si no se rellena, se usa "onboarding@resend.dev" (solo válido para pruebas)
RESEND_FROM=web@josehernandezmondejar.com

# ID del Audience de Resend donde se dan de alta los suscriptores del newsletter
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Email donde llegan los mensajes del formulario de contacto
CONTACT_EMAIL=contacto@josehernandezmondejar.com

# (Opcional) Upstash Redis para rate limiting en /api/contact y /api/newsletter
# Crear una base en https://console.upstash.com (plan gratuito: 10k req/día)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
